# Vision V2 - Environment Variables
# Copia este archivo a .env y completa los valores

# Base de datos TimescaleDB (requerido)
DATABASE_URL=postgresql://tsdbadmin@tu-servicio.tsdb.cloud.timescale.com:39384/tsdb?sslmode=require

# Redis (opcional, default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
LATEST_FRAME_MODE=1
ZONE_EXIT_GRACE_SECONDS=1.5
REENTRY_MERGE_SECONDS=2.0

# Configuración de ingesta (opcionales)
BATCH_SIZE=200
LOOP_SLEEP=0.2
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2.0

# Alertas (opcionales)
RESEND_API_KEY=re_tu_api_key_de_resend
ALERT_EMAIL_TO=tu-email@ejemplo.com
GOOGLE_API_KEY=tu_google_api_key

# Alertas: segundos mínimos sobre umbral antes de enviar alerta (ej. 240 = 4 min)
ALERT_MIN_EXCEED_SECONDS=240

